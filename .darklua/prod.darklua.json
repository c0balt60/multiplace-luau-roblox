{
  "generator": "retain_lines",
  "rules": [
    {
      "rule": "convert_require",
      "current": {
        "name": "luau",
        "use_luau_configuration": true
      },
      "target": {
        "name": "roblox",
        "rojo_sourcemap": "../sourcemap.json",
        "indexing_style": "wait_for_child"
      }
    },
    {
      "rule": "append_text_comment",
      "text": "--!optimize 2"
    },
    {
      "rule": "inject_global_value",
      "identifier": "__BUILD__",
      "value": "prod"
    },
    {
      "rule": "inject_global_value",
      "identifier": "__DEV_TOOLS__",
      "env_json": "BUILD_DEV_TOOLS_FLAG"
    },
    {
      "rule": "inject_global_value",
      "identifier": "__VERBOSE__",
      "env_json": "BUILD_VERBOSE_FLAG"
    },
    {
      "rule": "inject_global_value",
      "identifier": "__DEBUG__",
      "env_json": "BUILD_DEBUG_FLAG"
    },
    "group_local_assignment",
    "remove_nil_declaration",
    "compute_expression",
    "remove_unused_if_branch",
    "remove_unused_variable",
    "remove_unused_while",
    "remove_empty_do",
    "filter_after_early_return"
  ]
}
