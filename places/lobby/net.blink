option ClientOutput = "src/client/net.luau"
option ServerOutput = "src/server/net.luau"

import "../common/net" as Common

scope Queue {
    event OpenInterface {
        From: Server,
        Type: Reliable,
        Call: SingleAsync,
    }

    event CloseInterface {
        From: Server,
        Type: Reliable,
        Call: SingleAsync
    }

    event Create {
        From: Client,
        Type: Reliable,
        Call: SingleAsync,
        Data: u8
    }
}

scope Teleport {
    event Play {
        From: Client,
        Type: Reliable,
        Call: SingleAsync
    }

    event Classes {
        From: Client,
        Type: Reliable,
        Call: SingleAsync
    }

    event Weapons {
        From: Client,
        Type: Reliable,
        Call: SingleAsync
    }
}
